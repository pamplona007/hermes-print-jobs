{
  "name": "hermes-print-jobs-dashboard",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.tsx --bundle --outfile=dist/index.js --platform=browser --target=es2020 --format=iife --global-name=HermesPrintJobs",
    "watch": "esbuild src/index.tsx --bundle --outfile=dist/index.js --platform=browser --target=es2020 --format=iife --global-name=HermesPrintJobs --watch"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "esbuild": "^0.28.0",
    "react": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
